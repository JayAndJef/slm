# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data & model artifacts (large, local-only). data/ holds the encoded corpora and the
# trained tokenizer; notebooks/tokenizer.json is still tracked (no *.json rule).
# NOTE: a checkpoint is unusable without the tokenizer that produced its ids, so
# data/tokenizer-32k.json has to be distributed alongside any published weights.
data/
*.npy
checkpoints/
*.pt
*.log

# Experiment tracking. WandbLogger writes run state to wandb/, and Lightning's default
# ModelCheckpoint writes full checkpoints to <wandb_project>/<run_id>/checkpoints/ — so the
# directory name follows --wandb-project and can't be listed exhaustively. *.ckpt catches
# the large files wherever they land; the two below are the project names used so far.
wandb/
jlm/
slm-test/
lightning_logs/
*.ckpt

# Notebook scratch
.ipynb_checkpoints/

# Local tool settings
.claude/settings.local.json
